<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- dotnet user-secrets: local dev's Postgres connection string, Google client id, and JWT
         signing key live here, never in a committed appsettings*.json. -->
    <UserSecretsId>a40194a6-4f53-4048-ae36-b2872bd4fb24</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Triviador.Domain\Triviador.Domain.csproj" />
    <ProjectReference Include="..\..\Triviador.Application\Triviador.Application.csproj" />
    <ProjectReference Include="..\..\Triviador.Infrastructure\Triviador.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Data\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <Target Name="BuildClient" BeforeTargets="BeforePublish" Condition="'$(SkipClientBuild)' != 'true'">
    <Exec Command="npm ci" WorkingDirectory="$(MSBuildProjectDirectory)\..\..\Triviador.Client" />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)\..\..\Triviador.Client" />
  </Target>

</Project>
